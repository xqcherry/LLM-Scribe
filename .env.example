########################################
# LLM-Scribe 环境变量示例（模板文件）
# 复制为 .env 后再填写真实配置：
########################################


########## 数据库配置 ##########
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=xxx
DB_PASSWORD=xxx
DB_NAME=xxx
DB_CHARSET=utf8mb4


########## Moonshot LLM ##########
# 在 https://moonshot.cn/ 获取 API Key
LLM_API_KEY=


########## 消息增量 ##########
INCR_ENABLED=true
INCR_MIN_MESSAGES=20
INCR_MAX_MESSAGES=500
INCR_MERGE_MODE=template
INCR_BATCH_RETENTION_HOURS=72


########## 忽略的 QQ 号（可选） ##########
# 逗号分隔，例如：IGNORE_QQ=123456,654321
IGNORE_QQ=